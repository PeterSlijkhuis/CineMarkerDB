{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PeterSlijkhuis/CineMarkerDB/main/schema.json",
  "title": "CineMarker movie file",
  "description": "Markers for one cut of one movie. Stored at movies//{tmdb_id}.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tmdb_id", "runtime", "markers"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "tmdb_id": { "type": "integer", "minimum": 1, "description": "Must match the file name." },
    "imdb_id": { "type": "string", "pattern": "^tt\\d{7,9}$" },
    "title": { "type": "string", "description": "For humans only. The plugin ignores it." },
    "year": { "type": "integer", "minimum": 1870 },
    "runtime": {
      "$ref": "#/$defs/time",
      "description": "Runtime of the cut these timestamps were taken from. The plugin skips the file when the local file's runtime differs by more than a small tolerance (different edition, or a version with studio logos cut)."
    },
    "markers": {
      "type": "array",
      "minItems": 1,
      "description": "Sorted by start, ascending.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "type", "title"],
        "properties": {
          "start": { "$ref": "#/$defs/time" },
          "type": {
            "enum": ["intro", "music", "scare", "action", "plot", "credits", "post_credits", "other"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Plain text, no emoji. The plugin builds the chapter name as '{emoji} {title}'."
          },
          "emoji": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "description": "Optional. Overrides the default emoji for the type."
          }
        }
      }
    }
  },
  "$defs": {
    "time": {
      "type": "string",
      "pattern": "^\\d{2}:[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?$",
      "description": "hh:mm:ss with optional milliseconds, e.g. 01:05:12 or 01:05:12.500"
    }
  }
}
